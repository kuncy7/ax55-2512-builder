# Seed config for TP-Link Archer AX55 v1 on openwrt-25.12 (patch mode).
# `make defconfig` expands this to a full .config.
#
# No CONFIG_TESTING_KERNEL here: 25.12 builds the default 6.12 kernel and
# the symbol does not exist, so the post-defconfig sweep would (rightly)
# fail the build over it.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_tplink_archer-ax55-v1=y

# WiFi is the only access path to the board until ethernet is proven on a
# given image; keep the BDF package built-in (prepare-build.sh asserts it).
CONFIG_PACKAGE_ipq-wifi-tplink_ax55v1=y

# LuCI web interface (matches what downstream builds ship).
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# Small diagnostics that have proven useful on this board.
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump-mini=y

# USB storage + filesystems, matching the eko.one.pl image set, so a boot
# with a stick inserted exercises the same code path (sd probe, block
# hotplug, mounts) - needed to verify the 0923 SS fix and the LAN-degraded-
# when-booted-with-a-stick report on 6.12. usbutils/hdparm for the
# enumeration-speed and throughput proof.
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_ksmbd-server=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_hdparm=y
