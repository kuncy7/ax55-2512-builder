diff --git a/target/linux/generic/pending-6.18/930-1-net-dsa-realtek-rtl8365mb-detect-RTL8367S-VB.patch b/target/linux/generic/pending-6.18/930-1-net-dsa-realtek-rtl8365mb-detect-RTL8367S-VB.patch
