diff --git a/target/linux/generic/pending-6.18/930-6-net-dsa-realtek-rtl8365mb-set-clear-pvid-for-family-D.patch b/target/linux/generic/pending-6.18/930-6-net-dsa-realtek-rtl8365mb-set-clear-pvid-for-family-D.patch
